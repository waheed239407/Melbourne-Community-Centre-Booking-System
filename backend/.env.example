# Copy this file to .env, then enter your own PostgreSQL password and random JWT secret.
PGHOST=localhost
PGPORT=5432
PGDATABASE=mccbs_task3
PGUSER=postgres
PGPASSWORD=REPLACE_WITH_YOUR_LOCAL_POSTGRES_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DEMO_PASSWORD=REPLACE_WITH_A_PRIVATE_DEMO_PASSWORD_AT_LEAST_10_CHARACTERS
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Optional: supply SMTP to send real verification emails.
# Without SMTP, verification codes are printed ONLY in the backend terminal in development mode.
NODE_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MCCBS <no-reply@example.com>
